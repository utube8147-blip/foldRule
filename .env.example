# Copy to .env.local and fill in. Never commit real keys.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL of the deployment, used for canonical links, Open Graph images,
# robots.txt and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://foldrule.app

# ── Accounts (Supabase Auth) ─────────────────────────────────────────────────
# From your Supabase project: Settings → API. Both values are public by design
# (they ship to the browser). NEVER put the service_role key here.
# Leave empty to run in local mode (no accounts, nothing gated) — fine for dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Lab / test-bench routes ───────────────────────────────────────────────────
# Lab pages (/magicFill, /PdfCVMatchPage, /Snap) and the
# Roboflow proxy run automatically in `npm run dev`. In a production build they
# return 404 unless this is "true".
NEXT_PUBLIC_ENABLE_LABS=false

# ── Roboflow (lab features only) ──────────────────────────────────────────────
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_API_KEY=
# Optional comma-separated allow-lists. Recommended whenever labs are enabled
# on a public deployment, so the proxy can't be used for other models.
ROBOFLOW_ALLOWED_WORKSPACES=
ROBOFLOW_ALLOWED_MODELS=
# Set to "true" to log full Roboflow responses on the server.
ROBOFLOW_DEBUG=false
# Only needed for the workflow fallback upload.
IMGBB_API_KEY=
