# Copy to .env.local and fill in. Never commit real keys.

# ── Lab / test-bench routes ───────────────────────────────────────────────────
# Lab pages (/magicFill, /PdfCVMatchPage, /Snap), the auth placeholders and the
# Roboflow proxy run automatically in `npm run dev`. In a production build they
# return 404 unless this is "true".
NEXT_PUBLIC_ENABLE_LABS=false

# ── Roboflow (lab features only) ──────────────────────────────────────────────
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_API_KEY=
# Optional comma-separated allow-lists. Recommended whenever labs are enabled
# on a public deployment, so the proxy can't be used for other models.
ROBOFLOW_ALLOWED_WORKSPACES=
ROBOFLOW_ALLOWED_MODELS=
# Set to "true" to log full Roboflow responses on the server.
ROBOFLOW_DEBUG=false
# Only needed for the workflow fallback upload.
IMGBB_API_KEY=
